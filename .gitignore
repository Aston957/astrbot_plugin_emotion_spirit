__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.bak
*.tmp
.DS_Store

# Python packaging build artifacts (Phase 4 C2)
*.egg-info/
build/
dist/

# Phase 4 C4: emotion_spirit/output/ is now a source sub-package.
# Repo-root `output/` (created at runtime by 3.0A property-test scripts) is
# unrelated to the source layout and should remain ignored; the source
# sub-package is whitelisted via the negation below.
output/
!emotion_spirit/output/
!emotion_spirit/output/__init__.py

# === Release build: data/ tracking ===
# `data/` holds runtime resources (cmd_config.json, t2i_templates/) that
# the plugin needs at runtime. We DO want them tracked by git so they
# end up in the release zip. But we DON'T want transient tool outputs
# (data/temp/, data/t2i_templates/*.bak, etc.) tracked.
#
# Strategy: ignore the whole data/ dir, then re-include only the files
# that should be shipped.
data/
!data/cmd_config.json
!data/t2i_templates/
!data/t2i_templates/*.html

# verification/output/ is simulation harness output, never shipped.
verification/output/

# data/temp/ is a scratch directory used by some tools during execution.
data/temp/
