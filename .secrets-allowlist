# .secrets-allowlist - File patterns to skip during secret scanning.
# One glob pattern per line. Lines starting with # are comments.
#
# WARNING: Only add entries here if you have VERIFIED the pattern is a
# false positive (e.g., a regex pattern in test code, a documentation
# example, etc.). Never add a file that contains real secrets.
#
# Format: fnmatch-style glob (e.g., "tests/test_*.py", "docs/**")

# Self-reference (the checker itself contains all secret patterns as examples)
scripts/check_secrets.py

# install_hooks.sh has heredoc test instructions with example token patterns
scripts/install_hooks.sh

# Test files often have fake "example" secrets
tests/test_*.py
tests/**/test_*.py
verification/**

# Documentation
CHANGELOG.md
STRUCTURE_REPORT.md
docs/**

# This file itself
.secrets-allowlist
